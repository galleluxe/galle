# Payload CMS + Drizzle (same Neon database — use pooled connection string)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/storefront?sslmode=require
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Production URL
NEXT_PUBLIC_SITE_URL=https://www.galle.com

# ImageKit
NEXT_PUBLIC_IMAGEKIT_ENDPOINT=https://ik.imagekit.io/galleluxe
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# ISR revalidation
REVALIDATE_SECRET=galle_revalidate_secret

# Resend — https://resend.com/api-keys
# Until galleluxe.com is verified in Resend, use onboarding@resend.dev and only send to your Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=GALLE <onboarding@resend.dev>
# Optional: inbox for new-order alerts (must be allowed by your Resend plan / domain)
RESEND_ORDER_NOTIFY_EMAIL=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket — https://app.shiprocket.in → Settings → API → Configure → Create API user
# NOTE: There is NO sandbox/test mode in Shiprocket. All calls affect your real account.
# To test: create an order, then cancel it from the Shiprocket dashboard (full refund).
# SHIPROCKET_EMAIL must be a different email from your Shiprocket login email.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Name of the pickup location in your Shiprocket dashboard (default: Primary)
SHIPROCKET_PICKUP_LOCATION=Primary

# Observability (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
AXIOM_TOKEN=
AXIOM_DATASET=galle-storefront
LOG_LEVEL=info
