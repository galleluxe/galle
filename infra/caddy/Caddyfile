# Galle API — api.galle.com (DigitalOcean Bangalore VPS)
# TLS is automatic via Caddy + Cloudflare DNS

api.galle.com {
    encode gzip zstd

    reverse_proxy localhost:9000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /var/log/caddy/api.galle.com.log
        format json
    }
}

admin.galle.com {
    encode gzip zstd

    reverse_proxy localhost:9000 {
        header_up Host {host}
    }
}
